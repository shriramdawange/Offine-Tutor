# Generation mode: auto (cloud first, local fallback), api, or local
LLM_PROVIDER=auto

# Groq OpenAI-compatible API settings. Keep API_KEY private; do not commit real keys.
API_BASE_URL=https://api.groq.com/openai/v1
API_KEY=
API_MODEL=llama-3.3-70b-versatile
API_TIMEOUT=45

# Local Ollama fallback
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b-instruct-q4_K_M
OLLAMA_KEEP_ALIVE=20m
AUTO_PULL_LOCAL_MODEL=true
LOCAL_PULL_TIMEOUT=900

# Online search fallback (no API key / SDK required)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_URL=https://html.duckduckgo.com/html/
WEB_SEARCH_TIMEOUT=12
WEB_SEARCH_TOP_K=5
