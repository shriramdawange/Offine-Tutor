# Generation mode: auto (cloud first, local fallback), api, or local
LLM_PROVIDER=auto

# OpenAI-compatible API settings. Keep API_KEY private; do not commit real keys.
API_BASE_URL=https://api.openai.com/v1
API_KEY=
API_MODEL=gpt-4o-mini
API_TIMEOUT=45

# Local Ollama fallback
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b-instruct-q4_K_M
OLLAMA_KEEP_ALIVE=20m
AUTO_PULL_LOCAL_MODEL=true
LOCAL_PULL_TIMEOUT=900
